# =============================================================================
# GitTerm self-hosted stack — docker-compose.selfhost.yml
# =============================================================================
# cp .env.selfhost.example .env.selfhost
# docker compose --env-file .env.selfhost -f docker-compose.selfhost.yml up -d
#
# Generate secrets with:  openssl rand -hex 32
# =============================================================================

# Where users reach GitTerm. No trailing slash. Use https:// if TLS is
# terminated in front of the proxy container.
PUBLIC_URL=http://localhost:8888
PUBLIC_HOST=localhost:8888
# Host port the Caddy proxy listens on.
GITTERM_PORT=8888
# path      -> workspaces at PUBLIC_URL/ws/<workspace>/ (no DNS setup needed)
# subdomain -> workspaces at <port>-<workspace>.<PUBLIC_HOST>; requires wildcard
#              DNS and a wildcard TLS cert on your TLS terminator.
ROUTING_MODE=path

# --- Images -----------------------------------------------------------------
# GITTERM_IMAGE_PREFIX=ghcr.io/opeoginni/gitterm
# GITTERM_IMAGE_TAG=latest

# --- Database ---------------------------------------------------------------
POSTGRES_DB=gitterm
POSTGRES_USER=gitterm
POSTGRES_PASSWORD=

# --- Secrets (all required) --------------------------------------------------
BETTER_AUTH_SECRET=
WORKSPACE_JWT_SECRET=
INTERNAL_API_KEY=
# 32-byte hex key (64 chars) for AES-256-GCM credential encryption.
ENCRYPTION_MASTER_KEY=

# --- Admin bootstrap --------------------------------------------------------
# Creates/updates the admin account on start when email auth is enabled.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Auth -------------------------------------------------------------------
ENABLE_EMAIL_AUTH=true
ENABLE_GITHUB_AUTH=false
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# GitHub App for repo access (both or neither)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_NAME=
GITHUB_WEBHOOK_SECRET=

# --- Behaviour --------------------------------------------------------------
ENABLE_IDLE_REAPING=true

# --- Email (optional; logs to stdout when unset) ----------------------------
# EMAIL_PROVIDER=auto
# EMAIL_FROM=GitTerm <no-reply@example.com>
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Startup steps ----------------------------------------------------------
# Set to true to manage schema/seed yourself (e.g. a separate release job).
# SKIP_MIGRATIONS=false
# SKIP_SEED=false
# SKIP_ADMIN_SEED=false
