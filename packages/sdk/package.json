{
  "name": "@gitterm/sdk",
  "version": "0.1.3",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./direct": {
      "types": "./dist/direct/index.d.ts",
      "bun": "./dist/direct/index.js",
      "import": "./dist/direct/index.js",
      "default": "./dist/direct/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/direct/index.ts --outdir dist --target node --format esm --external @trpc/client --external eventsource --external @opencode-ai/sdk --external @opencode-ai/sdk/v2 --external e2b --external @asciidev/box-sdk --external @daytonaio/sdk --external @vercel/sandbox && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check-types && bun run build",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@asciidev/box-sdk": "^0.0.34",
    "@daytonaio/sdk": "^0.207.0",
    "@opencode-ai/sdk": "^1.18.25",
    "@trpc/client": "^11.8.1",
    "@vercel/sandbox": "^3.2.1",
    "e2b": "^2.46.1",
    "eventsource": "^5.1.1"
  },
  "devDependencies": {
    "@gitterm/api": "workspace:*",
    "@trpc/server": "catalog:",
    "@types/bun": "^1.2.6",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
