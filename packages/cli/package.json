{
  "name": "@gitterm/cli",
  "version": "0.5.1",
  "description": "Complete suit of gitterm tools in one CLI",
  "keywords": [
    "gitterm",
    "opencode",
    "sync"
  ],
  "homepage": "https://gitterm.dev",
  "license": "MIT",
  "author": "Opeyemi Oginni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpeOginni/gitterm.git",
    "directory": "packages/cli"
  },
  "bin": {
    "gitterm": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:local": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "prepublishOnly": "bun run build",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "chalk": "^5.6.2",
    "ora": "^10.0.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@gitterm/agent-runtime": "workspace:*",
    "@gitterm/config": "workspace:*",
    "@gitterm/move": "workspace:*",
    "@gitterm/schema": "workspace:*",
    "@gitterm/sdk": "workspace:*",
    "@opencode/client": "2.3.0",
    "@types/bun": "^1.2.6",
    "@types/yargs": "^17.0.35",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
