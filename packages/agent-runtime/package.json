{
  "name": "@gitterm/agent-runtime",
  "version": "0.2.0",
  "description": "Agent runtime and sandbox transports for GitTerm",
  "homepage": "https://gitterm.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpeOginni/gitterm.git",
    "directory": "packages/agent-runtime"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build $(find src -name '*.ts' ! -name '*.test.ts') --root src --outdir dist --target node --format esm --splitting --packages external && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check-types && bun run build",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@boatdev/sdk": "^1.13.0",
    "@daytonaio/sdk": "^0.207.0",
    "@opencode/client": "2.2.6",
    "@vercel/sandbox": "^3.2.1",
    "e2b": "^2.46.1"
  },
  "devDependencies": {
    "@gitterm/config": "workspace:*",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
