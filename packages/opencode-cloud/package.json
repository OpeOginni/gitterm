{
  "name": "@gitterm/opencode-cloud",
  "version": "0.3.6",
  "description": "Continue OpenCode sessions and local checkout changes in GitTerm cloud workspaces with /cloud",
  "keywords": [
    "gitterm",
    "opencode",
    "opencode-plugin",
    "remote-development",
    "workspace"
  ],
  "homepage": "https://gitterm.dev",
  "license": "MIT",
  "author": "Opeyemi Oginni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpeOginni/gitterm.git",
    "directory": "packages/opencode-cloud"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && vite build && bun build src/index.ts --outdir dist --target bun --format esm --external @opencode/plugin --external @opencode/client --external '@opencode/client/*' && bun run build-tui.ts && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "prepack": "bun run check-types && bun run build"
  },
  "dependencies": {
    "@opencode/client": "^2.3.0"
  },
  "devDependencies": {
    "@gitterm/move": "workspace:*",
    "@gitterm/sdk": "workspace:*",
    "@opencode/plugin": "^2.3.0",
    "@opencode/util": "2.3.0",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/bun": "^1.2.6",
    "solid-js": "1.9.17",
    "typescript": "^5.8.2",
    "uqr": "0.1.3",
    "vite": "7.1.12",
    "vite-plugin-solid": "2.11.10"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.3.0",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
