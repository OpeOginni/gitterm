{
  "name": "@gitterm/opencode-sandbox",
  "version": "0.1.2",
  "description": "Let your OpenCode agent run builds, tests, and previews in remote sandboxes while the session stays local",
  "keywords": [
    "e2b",
    "gitterm",
    "opencode",
    "opencode-plugin",
    "remote-execution",
    "sandbox",
    "tui"
  ],
  "homepage": "https://gitterm.dev",
  "license": "MIT",
  "author": "Opeyemi Oginni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpeOginni/gitterm.git",
    "directory": "packages/opencode-sandbox"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target bun --format esm --external @opencode/plugin && bun run build-tui.ts && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "prepack": "bun run check-types && bun run build"
  },
  "devDependencies": {
    "@gitterm/sdk": "workspace:*",
    "@opencode/plugin": "^2.2.6",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "^1.2.6",
    "solid-js": "1.9.17",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.6",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
