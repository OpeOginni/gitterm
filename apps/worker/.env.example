# =============================================================================
# WORKER CONFIGURATION
# =============================================================================

# Server URL for API calls
SERVER_URL=http://localhost:8888/api

# Internal API key (must match server's INTERNAL_API_KEY)
INTERNAL_API_KEY=dev-internal-key

# =============================================================================
# DEPLOYMENT MODE
# =============================================================================
# self-hosted: Idle reaping only, no quota enforcement (default)
# =============================================================================

DEPLOYMENT_MODE=self-hosted

# =============================================================================
# FEATURE FLAGS (Optional overrides)
# =============================================================================

# ENABLE_IDLE_REAPING=true         # Stop idle workspaces (default: true)
# REAP_INTERVAL_MINUTES=0          # 0 = run once and exit (Railway Cron).
#                                  # >0 = loop forever, e.g. 10 for self-hosted Docker.
