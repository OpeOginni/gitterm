{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "turbo build --filter=anon-reaper",
    "watchPatterns": [
      "apps/anon-reaper/**/*",
      "packages/api/**/*",
      "packages/config/**/*",
      "turbo.json",
      "package.json",
      "bun.lock"
    ]
  },
  "deploy": {
    "startCommand": "cd apps/anon-reaper && bun run dist/anon-reaper.mjs",
    "cronSchedule": "*/5 * * * *"
  }
}
