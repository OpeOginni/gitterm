# =============================================================================
# WEB APP CONFIGURATION
# =============================================================================

# Base domain for workspace URL display
NEXT_PUBLIC_BASE_DOMAIN=localhost

# Self-hosted always uses email login. Managed deployments may configure the
# authentication methods below and set NEXT_PUBLIC_DEPLOYMENT_MODE=managed.
NEXT_PUBLIC_DEPLOYMENT_MODE=self-hosted
NEXT_PUBLIC_ENABLE_EMAIL_AUTH=false
NEXT_PUBLIC_ENABLE_GITHUB_AUTH=true

# Billing and Pricing
# NEXT_PUBLIC_ENABLE_BILLING enables payment processing via Polar
NEXT_PUBLIC_ENABLE_BILLING=false

# API server URL (for tRPC)
NEXT_PUBLIC_SERVER_URL=http://localhost:8888/api

# Auth URL (for better-auth) - do NOT include /api suffix
# better-auth automatically appends /api/auth to this URL
NEXT_PUBLIC_AUTH_URL=http://localhost:8888

# Listener URL (for SSE/real-time updates)
NEXT_PUBLIC_LISTENER_URL=http://localhost:8888/listener

# GitHub App name (for installation link - optional)
NEXT_PUBLIC_GITHUB_APP_NAME=

# Web3Forms access key for enterprise contact form
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional browser analytics and sanitized exceptions — production + explicit consent only.
# Leave both unset to exclude the browser PostHog SDK from self-hosted builds.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional source-map upload for the deployment build. CI-only secret, NEVER NEXT_PUBLIC.
# Requires browser analytics configuration above. Maps are deleted after upload.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
# Set to the deployed git commit SHA, not an unrelated build/version.
POSTHOG_RELEASE_VERSION=
