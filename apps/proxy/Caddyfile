{
	# Global options
	auto_https off
	admin off

	# Server options
	servers {
		protocols h1 h2
	}
}

# SUBDOMAIN-BASED ROUTING (MANAGED)
#
# This is the Caddyfile for managed deployments with wildcard DNS.
# Used by Dockerfile.managed for Railway managed deployment.
#
# Subdomain Format Support:
# - <port>-<subdomain>.gitterm.dev : Workspace port routing (auto-generated)
# - Reserved (blocked):             api, www, admin, etc.
#
# Environment Variables:
# - SERVER_URL       -> API server URL (e.g., server.railway.internal:8080)
# - INTERNAL_API_KEY -> Shared key for internal API calls
# - COMPUTE_UPSTREAM -> Compute's HTTPS origin, not its public proxy hostname

http://compute.gitterm.dev {
	reverse_proxy {$COMPUTE_UPSTREAM:localhost:4100} {
		header_up Host {http.reverse_proxy.upstream.host}
	}
}

# Listen on port 80 for all requests
:80 {
	# Routing and provider-access headers are internal: drop any a client sends. Caddy
	# 2.10 forward_auth leaves a client-supplied copy_headers header in place when the auth
	# response does not set it (2.11 removes it). Never list Authorization in copy_headers:
	# it belongs to the app a request is for, and 2.11 would strip it from every port.
	request_header -X-Subdomain
	request_header -X-Hosting-Type
	request_header -X-Workspace-ID
	request_header -X-User-ID
	request_header -X-Upstream-URL
	request_header -X-Container-*
	request_header -X-GitTerm-*
	request_header -X-Exedev-Authorization
	request_header -e2b-traffic-access-token
	request_header -x-daytona-preview-token
	request_header -X-Daytona-Skip-Preview-Warning

	# Health check endpoint
	handle /health {
		header Content-Type application/json
		respond `{"status":"UP","mode":"managed"}` 200
	}

	# Block reserved subdomains at the Caddy level (defense in depth)
	# These should already be blocked at workspace creation, but this provides an extra layer
	@reserved_subdomain header_regexp subdomain Host ^(api|cloud|compute)\.gitterm\.dev$|^\d+-compute\.gitterm\.dev$
	handle @reserved_subdomain {
		root * /srv/errors
		rewrite * /unavailable.html
		file_server
	}

	# Main proxy handler
	handle {
		# Forward auth to API server (validates workspace exists and user has access)
		# The API returns HTML error pages directly for non-2xx responses
		forward_auth {$SERVER_URL} {
			uri /api/internal/proxy-resolve

			# Copy headers from auth response into request including some for specific providers
			copy_headers X-Hosting-Type X-Workspace-ID X-User-ID X-Subdomain X-Container-Host X-Container-Port X-Container-Protocol X-GitTerm-Aws-Routing-Key X-GitTerm-Boat-Token X-Exedev-Authorization e2b-traffic-access-token x-daytona-preview-token X-Daytona-Skip-Preview-Warning x-gitterm-cf-sandbox-id x-gitterm-cf-internal-key x-gitterm-cf-port

			# Copy original headers
			header_up Host {host}
			header_up X-Internal-Key {$INTERNAL_API_KEY}
			header_up Cookie {header.Cookie}
			header_up X-Original-URI {uri}
			header_up X-Original-Method {method}
			header_up X-Routing-Mode subdomain

			# Enough idle connections to the API for a burst of proxied requests.
			transport http {
				keepalive_idle_conns_per_host 256
			}
		}

		@cloud_workspace {
			header X-Hosting-Type cloud
		}

		@cloud_workspace_https {
			header X-Hosting-Type cloud
			header X-Container-Protocol https
		}

		# Cloud workspaces: route to containers using dynamic host/port from headers
		route @cloud_workspace {
			# boat private ports authenticate with the _port_auth cookie. A ?_token= query
			# is only exchanged for that cookie via a redirect, which proxied API calls can't follow.
			@boat_private header X-GitTerm-Boat-Token *
			request_header @boat_private Cookie "{header.Cookie}; _port_auth={header.X-GitTerm-Boat-Token}"
			# OpenCode accepts its session cookie only when Origin matches Host, and Host is
			# rewritten to the container below. Same-origin requests to the agent route drop
			# Origin so the cookie still works; cross-site requests keep it and are rejected.
			# Port routes (<port>-<subdomain>) serve user apps and keep Origin untouched.
			@agent_same_origin {
				header_regexp agent_host Host ^[^.-]+\.
				expression {header.Origin} == "https://" + {host}
			}
			request_header @agent_same_origin -Origin
			handle @cloud_workspace_https {
				reverse_proxy {header.X-Container-Host}:{header.X-Container-Port} {
					# Standard proxy headers
					header_up Host {header.X-Container-Host}
					header_up X-Forwarded-Proto https
					header_up X-GitTerm-Aws-Routing-Key {header.X-GitTerm-Aws-Routing-Key}
					header_up e2b-traffic-access-token {header.e2b-traffic-access-token}
					header_up x-daytona-preview-token {header.x-daytona-preview-token}
					header_up X-Daytona-Skip-Preview-Warning {header.X-Daytona-Skip-Preview-Warning}
					header_up x-gitterm-cf-sandbox-id {header.x-gitterm-cf-sandbox-id}
					header_up x-gitterm-cf-internal-key {header.x-gitterm-cf-internal-key}
					header_up x-gitterm-cf-port {header.x-gitterm-cf-port}

					header_up X-Real-IP {remote_host}
					header_up User-Agent {header.User-Agent}
					# Never hand GitTerm session/anon cookies to workspace apps (public ports
					# can be visited by any signed-in user). App cookies still pass through.
					header_up Cookie "(?:^|;\s*)(?:__Secure-|__Host-)?(?:better-auth\.[^=;\s]+|gitterm_anon)=[^;]*" ""
					header_up Cookie "^;\s*" ""
					header_up X-Routing-Mode subdomain

					# Modify CSP header to allow data URIs for WebAssembly
					header_down Content-Security-Policy "default-src 'self'; connect-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:;"

					# Transport settings optimized for WebSocket/ttyd
					transport http {
						tls
						compression off
						dial_timeout 10s
						response_header_timeout 0
						expect_continue_timeout 0
						keepalive 2m
						keepalive_idle_conns 1024
						keepalive_idle_conns_per_host 32
						read_buffer 32768
						write_buffer 32768
					}

					# Serve error pages with the upstream status so clients see the
					# real failure. `method GET` is required: file_server rejects
					# other methods with 405, which masked every failing POST.
					@unavailable status 403 404 503
					handle_response @unavailable {
						root * /srv/errors
						rewrite * /unavailable.html
						method GET
						file_server {
							status {rp.status_code}
						}
					}

					@server_error status 500 502 504
					handle_response @server_error {
						root * /srv/errors
						rewrite * /unavailable.html
						method GET
						file_server {
							status {rp.status_code}
						}
					}
				}
			}

			handle {
				reverse_proxy {header.X-Container-Host}:{header.X-Container-Port} {
					# Standard proxy headers
					header_up Host {header.X-Container-Host}
					header_up X-Forwarded-Proto https
					header_up X-GitTerm-Aws-Routing-Key {header.X-GitTerm-Aws-Routing-Key}
					header_up e2b-traffic-access-token {header.e2b-traffic-access-token}
					header_up x-gitterm-cf-sandbox-id {header.x-gitterm-cf-sandbox-id}
					header_up x-gitterm-cf-internal-key {header.x-gitterm-cf-internal-key}
					header_up x-gitterm-cf-port {header.x-gitterm-cf-port}
					header_up X-Real-IP {remote_host}
					header_up User-Agent {header.User-Agent}
					# Never hand GitTerm session/anon cookies to workspace apps (public ports
					# can be visited by any signed-in user). App cookies still pass through.
					header_up Cookie "(?:^|;\s*)(?:__Secure-|__Host-)?(?:better-auth\.[^=;\s]+|gitterm_anon)=[^;]*" ""
					header_up Cookie "^;\s*" ""
					header_up X-Routing-Mode subdomain

					# Modify CSP header to allow data URIs for WebAssembly
					header_down Content-Security-Policy "default-src 'self'; connect-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:;"

					# Transport settings optimized for WebSocket/ttyd
					transport http {
						compression off
						dial_timeout 10s
						response_header_timeout 0
						expect_continue_timeout 0
						keepalive 2m
						keepalive_idle_conns 1024
						keepalive_idle_conns_per_host 32
						read_buffer 32768
						write_buffer 32768
					}

					# Serve error pages with the upstream status so clients see the
					# real failure. `method GET` is required: file_server rejects
					# other methods with 405, which masked every failing POST.
					@unavailable status 403 404 503
					handle_response @unavailable {
						root * /srv/errors
						rewrite * /unavailable.html
						method GET
						file_server {
							status {rp.status_code}
						}
					}

					@server_error status 500 502 504
					handle_response @server_error {
						root * /srv/errors
						rewrite * /unavailable.html
						method GET
						file_server {
							status {rp.status_code}
						}
					}
				}
			}
		}
	}

	# Error handling with nice HTML pages
	# Security: Group 401/403/404 together to prevent workspace enumeration
	handle_errors {
		# file_server rejects non-GET methods with 405, which masked the real
		# error status on failing POSTs. Rewrite to GET and serve the page
		# with the original error status.
		method GET

		# Access denied / not found - use same response to prevent enumeration
		@unavailable expression {err.status_code} == 401 || {err.status_code} == 403 || {err.status_code} == 404
		handle @unavailable {
			header Content-Type text/html
			root * /srv/errors
			rewrite * /unavailable.html
			file_server {
				status {err.status_code}
			}
		}

		# Server errors (5xx)
		@server_error expression {err.status_code} >= 500
		handle @server_error {
			header Content-Type text/html
			root * /srv/errors
			rewrite * /unavailable.html
			file_server {
				status {err.status_code}
			}
		}

		# Bad request (400)
		@bad_request expression {err.status_code} == 400
		handle @bad_request {
			header Content-Type text/html
			root * /srv/errors
			rewrite * /unavailable.html
			file_server {
				status {err.status_code}
			}
		}

		# Default fallback
		handle {
			header Content-Type text/html
			root * /srv/errors
			rewrite * /unavailable.html
			file_server {
				status {err.status_code}
			}
		}
	}
}
