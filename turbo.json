{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": false,
      "env": [
        "POSTHOG_PROJECT_ID",
        "POSTHOG_API_HOST",
        "POSTHOG_RELEASE_VERSION",
        "RAILWAY_GIT_COMMIT_SHA"
      ],
      "passThroughEnv": ["POSTHOG_API_KEY"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "persistent": true
    },
    "db:studio:dev": {
      "cache": false,
      "persistent": true
    },
    "db:studio:prod": {
      "cache": false,
      "persistent": true
    },
    "db:migrate:dev": {
      "cache": false,
      "persistent": true
    },
    "db:migrate:prod": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "persistent": true
    },
    "infra:up": {
      "cache": false,
      "persistent": true
    },
    "infra:stop": {
      "cache": false,
      "persistent": true
    },
    "infra:down": {
      "cache": false,
      "persistent": true
    },
    "db:seed:dev": {
      "cache": false,
      "persistent": true
    },
    "db:seed:prod": {
      "cache": false,
      "persistent": true
    },
    "db:seed-admin": {
      "cache": false,
      "persistent": true
    },
    "ngrok": {
      "cache": false,
      "persistent": true
    },
    "e2b:build": {
      "cache": false,
      "persistent": true
    }
  }
}
