SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-socket-mode-token

GITTERM_PROVIDER=e2b
E2B_API_KEY=
E2B_TEMPLATE_ID=your-opencode-template

# Use the matching block when GITTERM_PROVIDER is changed.
# DAYTONA_API_KEY=
# DAYTONA_TARGET=us
# DAYTONA_IMAGE=
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# VERCEL_IMAGE=
# ASCII_API_KEY=
# EXEDEV_API_TOKEN=
# EXEDEV_IMAGE=
# RAILWAY_API_TOKEN=
# RAILWAY_PROJECT_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_REGION=
# RAILWAY_IMAGE=

# ephemeral: one sandbox per request; thread: pause/reuse per Slack thread;
# persistent: keep one sandbox alive per channel.
GITTERM_BOT_LIFECYCLE=thread

# thread: rebuild context from Slack; session: reuse OpenCode context; both: do both.
GITTERM_BOT_CONTEXT=both
GITTERM_BOT_STATE_FILE=.gitterm-slack-state.json
GITTERM_BOT_REPO=https://github.com/your-org/your-repo
GITTERM_BOT_BRANCH=main
GITTERM_BOT_MODEL=anthropic/claude-sonnet-4-20250514
ANTHROPIC_API_KEY=
GITTERM_RUN_TIMEOUT_MS=900000
GITTERM_KEEP_ALIVE_MS=3600000
