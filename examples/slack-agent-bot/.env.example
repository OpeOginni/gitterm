SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-socket-mode-token

GITTERM_API_TOKEN=gt_your-api-token
# Defaults to the local server. Set this when using another Gitterm server.
GITTERM_SERVER_URL=http://localhost:3000

# Required only by `bun run start:direct`.
E2B_API_KEY=e2b_your-api-key
E2B_SIZE=standard
# E2B_TEMPLATE_ID=
# E2B_TIMEOUT_MS=1200000

# When true, a top-level mention also includes recent channel messages before it.
# Mentions that already sit in a Slack thread always get that thread as first-message context.
GITTERM_BOT_PRECONTEXT=false
GITTERM_BOT_STATE_FILE=.gitterm-slack-hosted-state.json
# Direct mode uses a separate file containing sensitive provider runtime credentials.
GITTERM_BOT_DIRECT_STATE_FILE=.gitterm-slack-direct-state.json
GITTERM_BOT_REPO=https://github.com/your-org/your-repo
GITTERM_BOT_BRANCH=main
# Optional. Leave empty to use the workspace default model.
GITTERM_BOT_MODEL=
GITTERM_RUN_TIMEOUT_MS=900000
